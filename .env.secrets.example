# Copy this file to .env.secrets or .env.<environment>.secrets.
# Never commit real secret values.

OPENROUTER_API_KEY=replace-in-deployment
EMBEDDING_API_KEY=ollama
DATABASE_URL=replace-in-deployment
POSTGRES_PASSWORD=replace-in-deployment
DB_PASSWORD=replace-in-deployment
JWT_SECRET=development-only-long-random-secret

# Ollama's local OpenAI-compatible endpoint accepts any non-empty key.
OLLAMA_API_KEY=ollama
