# Choose runtime environment.
# Supported values: development, testing, staging, production
APP_ENV=development
DEBUG=true

# Supported values: sqlite, postgres
DATABASE_PROVIDER=postgres
DATABASE_PATH=toko.db
KNOWLEDGE_BASE_PATH=knowledge_base.txt
KNOWLEDGE_BASE_DIR=knowledge_base
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_BASE=http://localhost:11434/v1
VECTOR_DIMENSION=768

# Choose the LLM provider without changing application/business code.
# Supported values: openrouter, ollama
LLM_PROVIDER=openrouter

# OpenRouter non-secret config.
OPENROUTER_MODEL=openrouter/free
# Optional pinned/provider-observed model version. Leave empty when using an alias.
OPENROUTER_MODEL_VERSION=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Ollama non-secret config for local development.
# To use it, set LLM_PROVIDER=ollama and make sure Ollama is running locally.
OLLAMA_MODEL=llama3.1
# Optional local pinned model digest/tag. Leave empty to record the model alias as unpinned.
OLLAMA_MODEL_VERSION=
OLLAMA_API_BASE=http://localhost:11434/v1

# Controlled write actions.
# Keep high-risk order mutations disabled until business approval is ready.
HIGH_RISK_WRITE_ACTIONS_ENABLED=false
