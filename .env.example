# Choose runtime environment.
# Supported values: development, testing, staging, production
APP_ENV=development
DEBUG=true

# Supported values: sqlite, postgres
DATABASE_PROVIDER=postgres
DATABASE_PATH=toko.db
KNOWLEDGE_BASE_PATH=knowledge_base.txt
KNOWLEDGE_BASE_DIR=knowledge_base
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_BASE=http://localhost:11434/v1
VECTOR_DIMENSION=768

# Choose the LLM provider without changing application/business code.
# Supported values: openrouter, ollama, deepseek, kimi
# Keep OpenRouter free as the current default. Paid providers appear in the UI only after their key is configured.
LLM_PROVIDER=openrouter

# OpenRouter non-secret config.
OPENROUTER_MODEL=openrouter/free
# Optional pinned/provider-observed model version. Leave empty when using an alias.
OPENROUTER_MODEL_VERSION=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Ollama non-secret config for local development.
# To use it, set LLM_PROVIDER=ollama and make sure Ollama is running locally.
OLLAMA_MODEL=llama3.1
# Optional local pinned model digest/tag. Leave empty to record the model alias as unpinned.
OLLAMA_MODEL_VERSION=
OLLAMA_API_BASE=http://localhost:11434/v1

# Future paid production providers (non-secret config).
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_VERSION=
DEEPSEEK_API_BASE=https://api.deepseek.com
# Optional Phase 31 benchmark prices in USD per 1 million tokens.
# Leave empty until a current paid price has been verified.
DEEPSEEK_BENCHMARK_INPUT_PRICE_PER_MILLION=
DEEPSEEK_BENCHMARK_OUTPUT_PRICE_PER_MILLION=

KIMI_MODEL=kimi-k2.6
KIMI_MODEL_VERSION=
KIMI_API_BASE=https://api.moonshot.ai/v1
KIMI_BENCHMARK_INPUT_PRICE_PER_MILLION=
KIMI_BENCHMARK_OUTPUT_PRICE_PER_MILLION=

# Phase 32 model routing. Keep disabled until paid keys, prices, and benchmark results are ready.
MODEL_ROUTING_ENABLED=false
ROUTING_CHEAP_PROVIDER=openrouter
ROUTING_CHEAP_MODEL=openrouter/free
ROUTING_STANDARD_PROVIDER=deepseek
ROUTING_STANDARD_MODEL=deepseek-v4-flash
ROUTING_PREMIUM_PROVIDER=kimi
ROUTING_PREMIUM_MODEL=kimi-k2.6
ROUTING_CHEAP_TASKS=intent,extraction,product_search,orders,cart,escalation
ROUTING_STANDARD_TASKS=simple_rag
ROUTING_PREMIUM_TASKS=complex_rag,agentic_workflow
ROUTING_CONFIDENCE_THRESHOLD=0.70
ROUTING_EVIDENCE_THRESHOLD=0.65

# Controlled write actions.
# Keep high-risk order mutations disabled until business approval is ready.
HIGH_RISK_WRITE_ACTIONS_ENABLED=false

# Denial-of-wallet and resource abuse limits
MAX_INPUT_TOKENS=2000
MAX_OUTPUT_TOKENS=1200
MAX_TOOL_CALLS=6
MAX_AGENT_STEPS=4
MAX_AGENT_RUNTIME_SECONDS=60
MAX_REQUEST_COST_USD=0.05
# Set these to the maximum paid-model prices used for preflight cost reservation.
MAX_INPUT_PRICE_PER_MILLION=0
MAX_OUTPUT_PRICE_PER_MILLION=0
USER_RATE_LIMIT_REQUESTS=20
USER_RATE_LIMIT_WINDOW_SECONDS=60
TENANT_DAILY_REQUEST_QUOTA=1000
TENANT_DAILY_TOKEN_QUOTA=1000000
TENANT_DAILY_COST_QUOTA_USD=10
EXPENSIVE_REPEAT_LIMIT=3
EXPENSIVE_REPEAT_WINDOW_SECONDS=300

# Agent loop safety. A value of 1 allows one unique tool call and blocks its identical repeat.
MAX_IDENTICAL_TOOL_CALLS=1
MAX_LOW_PROGRESS_STEPS=2
MAX_PLANNING_CYCLE_LENGTH=3
